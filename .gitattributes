# Normalize line endings so the repo is clean across Windows/macOS/Linux.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Treat these as binary (no EOL translation, no diff noise).
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.pdf binary
*.jar binary
*.ico binary
